<Window x:Class="GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI"
        xmlns:xcad="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="MainWindow" Height="600" Width="1000">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo" />
    </Window.TaskbarItemInfo>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,6"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <TextBlock VerticalAlignment="Center" FontSize="12"
                           Text="MeiBrowser - All in one tool for browsing and downloading Hoyoverse games packages"
                           Foreground="{DynamicResource ControlDisabledForegroundBrush}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource ControlDisabledForegroundBrush}"/>
                    <ComboBox x:Name="ThemeSelector" Width="150" Height="28"
                              SelectionChanged="Theme_SelectionChanged"
                              VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- miniature of the theme: background, control, accent -->
                                    <Border Width="14" Height="14" Margin="0,0,8,0"
                                            Background="{Binding Swatch}"
                                            BorderBrush="#60000000" BorderThickness="1"
                                            SnapsToDevicePixels="True"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <xcad:DockingManager x:Name="Dock" AllowMixedOrientation="True"
                             Background="{DynamicResource WindowBackgroundBrush}">
            <layout:LayoutRoot>
                <layout:LayoutPanel Orientation="Vertical">
                    <layout:LayoutDocumentPaneGroup>
                        <layout:LayoutDocumentPane x:Name="DocumentPane"/>
                    </layout:LayoutDocumentPaneGroup>
                    <layout:LayoutAnchorablePaneGroup DockHeight="180">
                        <layout:LayoutAnchorablePane x:Name="BottomPane"/>
                    </layout:LayoutAnchorablePaneGroup>
                </layout:LayoutPanel>
            </layout:LayoutRoot>
        </xcad:DockingManager>
    </DockPanel>
</Window>
