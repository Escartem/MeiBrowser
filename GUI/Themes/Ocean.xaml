<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#0F1B2B</Color>
    <Color x:Key="WindowForegroundColor">#D6E4F0</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{StaticResource WindowForegroundColor}"/>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#16263B"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#24405E"/>
    <SolidColorBrush x:Key="ControlHighlightBrush" Color="#2E6DA4"/>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#101E2E"/>
    <SolidColorBrush x:Key="ControlDisabledForegroundBrush" Color="#6C8299"/>
</ResourceDictionary>
