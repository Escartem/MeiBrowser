<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#2E3440</Color>
    <Color x:Key="WindowForegroundColor">#ECEFF4</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{StaticResource WindowForegroundColor}"/>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#3B4252"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4C566A"/>
    <SolidColorBrush x:Key="ControlHighlightBrush" Color="#5E81AC"/>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#293241"/>
    <SolidColorBrush x:Key="ControlDisabledForegroundBrush" Color="#7B88A1"/>
</ResourceDictionary>
