<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#14201A</Color>
    <Color x:Key="WindowForegroundColor">#DDE7DF</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{StaticResource WindowForegroundColor}"/>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#1D2E25"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#2C4736"/>
    <SolidColorBrush x:Key="ControlHighlightBrush" Color="#3E7A54"/>
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#16241C"/>
    <SolidColorBrush x:Key="ControlDisabledForegroundBrush" Color="#7E9687"/>
</ResourceDictionary>
